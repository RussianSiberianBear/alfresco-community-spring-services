alfresco:
  # Only this value identifies the Alfresco server.
  # Change it here when the server/port changes.
  # Только это значение идентифицирует сервер Alfresco.
  # Измените его здесь при изменении сервера/порта.
  url: "http://localhost:9090"
  username: admin
  password: admin

spring:
  http:
    serviceclient:
      alfresco:
        base-url: "${alfresco.url}/alfresco/api/-default-/public/alfresco/versions/1"
        connect-timeout: 10s
        read-timeout: 60s
      alfresco-auth:
        base-url: "${alfresco.url}/alfresco/api/-default-/public/authentication/versions/1"
        connect-timeout: 10s
        read-timeout: 60s
      alfresco-search:
        base-url: "${alfresco.url}/alfresco/api/-default-/public/search/versions/1"
        connect-timeout: 10s
        read-timeout: 60s
      alfresco-discovery:
        base-url: "${alfresco.url}/alfresco/api"
        connect-timeout: 10s
        read-timeout: 60s
