alfresco:
  # Only this value identifies the Alfresco server.
  # Change it here when the server/port changes.
  # Только это значение идентифицирует сервер Alfresco.
  # Измените его здесь при изменении сервера/порта.
  url: "http://localhost:8082"
  username: admin
  password: admin
  http:
    connect-timeout: 5s
    read-timeout: 30s
    streaming-read-timeout: 10m
  health:
    enabled: true
  retry:
    enabled: true
    max-attempts: 3
    initial-delay: 200ms
    max-delay: 2s
  diagnostics:
    enabled: false
